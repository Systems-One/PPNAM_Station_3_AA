<!-- Panel behind a scan blocker (broker reconnecting, Station 3 offline, account not allowed).
     As plain text under the greyed Select Source button the reason read like the instruction
     copy above it, though it is the one thing the operator needs to know (skill critique
     2026-11-06, P2-3). Amber like the Reconnecting pill; text on it stays text_primary (11.2:1). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/light_amber" />
    <stroke android:width="1dp" android:color="@color/warning" />
    <corners android:radius="12dp" />
</shape>
