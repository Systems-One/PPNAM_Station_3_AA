<?xml version="1.0" encoding="utf-8"?>
<!-- Panel behind a failed scan (rejected source, timeout, station error). A bare red text line
     carried much less weight than the green "Source selected" card (visual critique 2026-11-06,
     P2-8). Text on it stays text_primary: danger on light_red is only 3.99:1. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/light_red" />
    <stroke android:width="1dp" android:color="@color/danger" />
    <corners android:radius="12dp" />
</shape>
